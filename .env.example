# 복사: Copy-Item .env.example .env 후 값 입력
# 위치: C:\dev\2026 new prjt\stock\.env (docker compose 는 이 폴더에서 실행 시 자동 로드)
# 모의·실전 앱키는 KIS 포털에서 발급

# 모의투자 (KIS)
KIS_PAPER_APPKEY="replace-me"
KIS_PAPER_SECRET="replace-me"

# 실전투자 (KIS)
KIS_REAL_APPKEY="replace-me"
KIS_REAL_SECRET="replace-me"

# 네이버 검색 API (뉴스)
NAVER_CLIENT_ID="replace-me"
NAVER_CLIENT_SECRET="replace-me"

# 백엔드 운영 보안
APP_SECURITY_USERNAME="ops"
APP_SECURITY_PASSWORD="replace-with-long-random-password"
APP_CORS_ALLOWED_ORIGINS="http://localhost:3000"
APP_SWAGGER_ENABLED="false"

# 프론트 서버/프록시가 운영 백엔드 Basic 인증에 사용할 값
BACKEND_BASIC_USERNAME="ops"
BACKEND_BASIC_PASSWORD="replace-with-long-random-password"
PROXY_ALLOWED_PREFIXES="market,dashboard,strategies,strategy,news,statistics,backtest,ai,broker,ops"

# AI 서비스 입력 제한
MAX_REQUEST_BYTES="1048576"
MAX_IMAGE_BASE64_LENGTH="750000"

# Gmail SMTP (비밀번호 찾기) — MAIL_PASSWORD 는 반드시 "앱 비밀번호"(16자리). 일반 비밀번호 불가
# Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호 → 메일
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
